{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Papyrxis Workspace project configuration",
  "type": "object",
  "required": ["schema_version", "project", "build"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["type", "languages"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["book", "booklet", "article", "cv"]},
        "title": {"type": "string"},
        "author": {"type": "string"},
        "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "output_dir": {"type": "string", "default": "build"},
        "default_engine": {"enum": ["pdflatex", "xelatex", "lualatex"]},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": {"type": "string"},
                  "engine": {"enum": ["pdflatex", "xelatex", "lualatex"]}
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "export": {
      "type": "object",
      "properties": {
        "output_dir": {"type": "string"},
        "targets": {"type": "array", "items": {"type": "string"}},
        "tag_limit": {"type": "integer", "minimum": 1, "maximum": 20}
      },
      "additionalProperties": true
    },
    "targets": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "additionalProperties": true
}
